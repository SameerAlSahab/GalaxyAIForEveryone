<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@id/recycler_item_view" android:layout_width="fill_parent" android:layout_height="fill_parent" android:hapticFeedbackEnabled="false" android:importantForAccessibility="noHideDescendants"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/blur_container" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <ImageView android:id="@id/blur_view" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="centerCrop" />
        <View android:id="@id/gradient_view" android:background="#4d000000" android:layout_width="fill_parent" android:layout_height="fill_parent" />
    </FrameLayout>
    <FrameLayout android:gravity="center" android:layout_gravity="center" android:id="@id/transform_parent_layout" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <FrameLayout android:gravity="center" android:layout_gravity="center" android:id="@id/transform_wrap_container" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <FrameLayout android:id="@id/transform_layout" android:layout_width="fill_parent" android:layout_height="fill_parent">
                <ImageView android:id="@id/thumbnail" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="matrix" android:contentDescription="@null" />
                <ImageView android:id="@id/ai_edit_thumbnail" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="matrix" android:contentDescription="@null" />
                <ImageView android:id="@id/backup_thumbnail" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="matrix" android:contentDescription="@null" />
                <FrameLayout android:id="@id/thumbnail_preview_layout" android:layout_width="fill_parent" android:layout_height="fill_parent" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
