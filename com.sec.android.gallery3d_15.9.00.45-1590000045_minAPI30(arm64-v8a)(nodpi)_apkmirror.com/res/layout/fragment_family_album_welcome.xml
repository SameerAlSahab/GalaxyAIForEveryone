<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView android:scrollbarStyle="outsideOverlay" android:id="@id/scrollView" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginTop="@dimen/family_album_welcome_page_title_port_top_margin" android:fillViewport="true" android:layout_above="@id/bottom_container" android:layout_alignParentTop="true" android:layout_centerHorizontal="true" android:paddingStart="@dimen/sesl_dialog_body_text_scroll_padding_start" android:paddingEnd="@dimen/sesl_dialog_body_text_scroll_padding_end" android:layout_marginHorizontal="@dimen/family_album_welcome_page_body_side_margin">
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/family_album_welcome_page_title_size" android:textColor="@color/about_page_version_text_color" android:gravity="center" android:layout_gravity="center_horizontal" android:id="@id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/family_album_welcome_page_title_bottom_margin" android:text="@string/create_a_shared_family_album" android:textAlignment="center" style="@style/OneUiRobotoSemiBold" />
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/space_for_so_many_memories" style="@style/FamilyAlbumWelcomeTitleStyle" />
                <TextView android:id="@id/quota_description" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/space_for_so_many_memories_description" style="@style/FamilyAlbumWelcomeSubtitleStyle" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/family_album_welcome_page_body_text_gap">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effortless_sharing" style="@style/FamilyAlbumWelcomeTitleStyle" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effortless_sharing_description" style="@style/FamilyAlbumWelcomeSubtitleStyle" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/family_album_welcome_page_body_text_gap">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/open_for_editing" style="@style/FamilyAlbumWelcomeTitleStyle" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_family_members_description" style="@style/FamilyAlbumWelcomeSubtitleStyle" />
            </LinearLayout>
            <View android:layout_width="wrap_content" android:layout_height="0.0dip" android:layout_marginBottom="@dimen/family_album_welcome_page_body_text_gap" android:layout_weight="1.0" />
            <TextView android:id="@id/expiry_days_description" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/FamilyAlbumWelcomeExpiryStyle" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@id/bottom_container" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_marginHorizontal="@dimen/family_album_welcome_page_bottom_container_horizontal_margin" android:layout_marginVertical="@dimen/family_album_welcome_page_bottom_container_vertical_margin">
        <TextView android:id="@id/button_later" android:layout_width="0.0dip" android:layout_height="wrap_content" android:text="@string/app_rating_popup_later_btn_text" android:layout_weight="1.0" android:layout_centerInParent="true" android:layout_marginHorizontal="@dimen/family_album_welcome_page_button_side_margin" style="@style/family_album_later_button" />
        <FrameLayout android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginHorizontal="@dimen/family_album_welcome_page_button_side_margin">
            <TextView android:id="@id/button_get_started" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/two_step_verification_dialog_button" android:layout_centerInParent="true" style="@style/family_album_get_started_button" />
            <androidx.appcompat.widget.SeslProgressBar android:layout_gravity="center" android:id="@id/progress" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" style="@style/ProgressCircle" />
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
