<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:focusable="true" android:clickable="true" android:layout_width="fill_parent" android:layout_height="fill_parent" android:paddingHorizontal="@dimen/suggestions_card_recycler_item_padding_horizontal"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout android:id="@id/thumbnail_container" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <com.samsung.android.gallery.widget.SquareImageView android:id="@id/thumbnail" android:background="@color/suggestions_card_recycler_item_thumbnail_bg_color" android:layout_width="fill_parent" android:layout_height="wrap_content" android:foreground="@drawable/suggestions_thumbnail_border" android:scaleType="centerCrop" app:aspect_ratio="1.33" />
        <View android:id="@id/dim_view" android:background="@color/suggestions_card_recycler_item_dim_view_color" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" />
    </FrameLayout>
    <TextView android:textSize="@dimen/suggestions_card_recycler_item_count_text_size" android:layout_gravity="center" android:id="@id/suggestions_count" android:visibility="gone" style="@style/SuggestionsCountStyle" />
    <LinearLayout android:gravity="center" android:layout_gravity="left|bottom" android:id="@id/play_icon" android:background="@drawable/gallery_suggestions_highlight_video_play_icon_bg" android:visibility="gone" android:layout_width="@dimen/suggestions_card_recycler_item_play_icon_bg_size" android:layout_height="@dimen/suggestions_card_recycler_item_play_icon_bg_size" android:layout_marginLeft="@dimen/suggestions_card_recycler_item_play_icon_left_margin" android:layout_marginBottom="@dimen/suggestions_card_recycler_item_play_icon_bottom_margin">
        <ImageView android:layout_width="@dimen/suggestions_card_recycler_item_play_icon_size" android:layout_height="@dimen/suggestions_card_recycler_item_play_icon_size" android:src="@drawable/ic_gallery_ic_detail_filmstrip_play" />
    </LinearLayout>
</FrameLayout>
