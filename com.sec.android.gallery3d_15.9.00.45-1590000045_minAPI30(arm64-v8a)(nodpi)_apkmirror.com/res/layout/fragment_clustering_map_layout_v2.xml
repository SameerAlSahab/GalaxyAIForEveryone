<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@id/main_layout" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <LinearLayout android:orientation="vertical" android:id="@id/toolbar_layout" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <com.samsung.android.gallery.widget.toolbar.GalleryToolbar android:id="@id/toolbar" app:layout_collapseMode="pin" style="@style/ToolbarTransparentStyle" />
        </LinearLayout>
        <RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
            <com.samsung.android.gallery.widget.RoundedFrameLayout android:id="@id/map_view" android:focusable="true" android:layout_width="fill_parent" android:layout_height="fill_parent" android:contentDescription="@string/map" />
            <ViewStub android:id="@id/autocomplete_list_view_container" android:layout="@layout/search_filter_autocomplete_layout" android:layout_width="fill_parent" android:layout_height="fill_parent" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/bottom_sheet_layout" android:background="@color/default_background" android:layout_width="fill_parent" android:layout_height="fill_parent" android:elevation="@dimen/search_pictures_location_elevation" app:layout_behavior="com.samsung.android.gallery.widget.behavior.SearchPicturesLocationBehavior">
        <ImageView android:layout_gravity="center_horizontal" android:visibility="visible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/search_pictures_location_handler_top_margin" android:src="@drawable/gallery_ic_bottomsheet_handle" />
        <TextView android:textSize="14.0sp" android:textColor="@color/time_view_title_color" android:layout_gravity="center_horizontal" android:id="@id/item_count" android:background="@color/transparent" android:paddingBottom="@dimen/search_pictures_location_count_padding_bottom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/search_pictures_location_count_top_margin" android:textAlignment="center" android:letterSpacing="0.0" style="@style/OneUiRobotoSemiBold" />
        <ViewStub android:id="@id/empty_view" android:layout="@layout/fragment_search_pictures_emptyview_stub" android:layout_width="fill_parent" android:layout_height="fill_parent" />
        <include android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginHorizontal="@dimen/search_pictures_layout_out_horizontal_margin" layout="@layout/gallery_list_view" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
